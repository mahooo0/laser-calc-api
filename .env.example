# Laser Calculator API — runtime configuration
# Copy this file to `.env` and edit. Lines starting with `#` are comments.

# Network
HOST=0.0.0.0
PORT=8080

# CORS — comma-separated list of allowed origins for /api/*.
# Use `*` for development. In production set explicit origins, e.g.:
# ALLOWED_ORIGINS=https://example.com,https://www.example.com
ALLOWED_ORIGINS=*

# Upload limit (bytes). Files larger than this return HTTP 413.
# Default: 10 MB.
MAX_UPLOAD_BYTES=10485760

# Data files. Override these when running in Docker so the host can
# edit prices and read orders without entering the container.
PRICES_CATALOG_PATH=./prices_catalog.json
ORDERS_CSV_PATH=./orders.csv

# Static frontend (legacy index.html). Optional.
WEB_DIR=./web

# Logging
LOG_LEVEL=INFO

# Telegram notifications — leave empty to disable.
# Get the token from @BotFather. Multiple chat_ids comma-separated.
# Group chat IDs are negative (e.g. -1001234567890); personal chat IDs are positive.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_ENABLED=true
TELEGRAM_TIMEOUT_SECONDS=5
